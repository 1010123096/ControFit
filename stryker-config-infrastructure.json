{
  "stryker-config": {
    "solution": "ControlFit.sln",
    "project": "ControlFit.Infrastructure/ControlFit.Infrastructure.csproj",
    "test-projects": ["ControlFit.Tests/ControlFit.Tests.csproj"],
    "thresholds": {
      "break": 20,
      "high": 60,
      "low": 20
    },
    "reporters": ["html", "json", "cleartext"],
    "output-path": "StrykerOutput/infrastructure",
    "test-case-filter": "FullyQualifiedName~Infrastructure|FullyQualifiedName~Application|FullyQualifiedName~Domain",
    "verbosity": "info",
    "concurrency": 4
  }
}
